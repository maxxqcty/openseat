# Copy to .env and adjust for local development.
# Never commit .env.

# Application
APP_ENV=development
APP_VERSION=dev
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8091

# Database
DATABASE_URL=postgresql+psycopg://openseat:openseat@localhost:5432/openseat

# Session
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-random-value-0123456789abcdef
SESSION_COOKIE_NAME=openseat_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false

# CORS (development only; production is same-origin)
CORS_ORIGINS=http://localhost:5173

# OpenTelemetry (leave empty to disable export locally)
OTEL_SERVICE_NAME=openseat
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Frontend
VITE_API_BASE_URL=/api
VITE_API_MODE=http
