# Dependencies and virtualenvs. The `**/` prefix is required: Docker matches
# bare patterns only at the build-context root, which is why `backend/.venv`
# and `frontend/node_modules` used to leak into the image.
**/node_modules
**/.venv
**/venv

# Python caches and bytecode
**/__pycache__
**/*.pyc
**/*.pyo

# Git
.git
.gitignore

# Tests and fixtures
**/tests
**/*.test.ts
**/*.test.tsx
**/test_*.py
**/*_test.py

# Build artifacts
**/dist
**/build
**/*.egg-info
**/htmlcov

# Caches
**/.cache
**/.eslintcache
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.vite
**/coverage
**/.nyc_output

# IDE and OS files
.vscode
.idea
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db

# Environment files
**/.env
**/.env.*

# Logs
**/*.log
**/npm-debug.log*

# CI, docs, and local tooling are not needed in the image
.github
.gitlab-ci.yml
e2e
_docs
.opencode
tmp
scratch
