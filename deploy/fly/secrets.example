# Secrets for one OpenSeat Fly app. Copy this file to `dev.secrets` or
# `prod.secrets` next to it (both are git-ignored), fill in real values, then
# run `make fly-secrets ENV=dev` (or `prod`). Never commit the filled-in file.
#
#   cp deploy/fly/secrets.example deploy/fly/dev.secrets
#
# DATABASE_URL is deliberately absent: `make fly-db` attaches a Fly Managed
# Postgres cluster and Fly writes DATABASE_URL as a secret on the app itself.

# At least 32 characters; generate one with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=replace-with-at-least-32-random-characters

# development for openseat-dev, production for openseat-prod.
APP_ENV=development

# Free-form; the seed stamps it into every row and /healthz reports it. The
# deploy scripts default it to the image tag being released.
APP_VERSION=dev
